{
  "name": "java-quarkus",
  "core": ">=9.0,<10",
  "order": 40,
  "family": "java",
  "requires": {
    "java": ">=1.0,<2"
  },
  "backends": {
    "java-quarkus": {
      "framework": "quarkus",
      "label": "Java — Quarkus owns startup (Agroal, Flyway, SmallRye Health, OIDC); Maven, Checkstyle/PMD/SpotBugs, JUnit 5",
      "targets": [
        "none",
        "existing",
        "aws",
        "azure"
      ],
      "options": {
        "event-store": [
          "memory",
          "sqlite",
          "postgres"
        ],
        "http": [
          "none",
          "quarkus-rest"
        ],
        "auth": [
          "none",
          "keycloak",
          "cognito",
          "entra",
          "auth0"
        ],
        "users": [
          "none",
          "keycloak",
          "cognito",
          "auth0"
        ]
      },
      "defaults": {
        "http": "quarkus-rest"
      }
    }
  },
  "axes": {
    "http": {
      "quarkus-rest": {
        "label": "Quarkus REST — JSON API on the framework's own HTTP layer, with SmallRye Health serving the readiness probe",
        "capabilities": [
          "http-quarkus-rest"
        ],
        "features": [
          "quarkus-rest"
        ],
        "containers": [],
        "migrations": false,
        "integration-suite": false,
        "targets": [
          "none",
          "existing",
          "aws",
          "azure"
        ],
        "app-in-compose": true,
        "note": "Dropping it takes SmallRye Health with it: the readiness probe is the framework's."
      }
    }
  }
}
